---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada - Portal O Montador de Móveis" description="A página que você procura não foi encontrada. Volte para a página inicial e encontre montadores de móveis profissionais na sua região." noindex>
	<main class="min-h-[60vh] flex items-center justify-center px-4">
		<section class="text-center py-16">
			<p class="font-headline text-8xl font-bold text-amber-500 mb-4">404</p>
			<h1 class="font-headline text-2xl md:text-3xl font-bold text-slate-800 mb-4">
				Página não encontrada
			</h1>
			<p class="text-slate-600 mb-8 max-w-md mx-auto">
				A página que você procura não existe ou foi movida. Encontre montadores de móveis profissionais na sua cidade:
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/" class="inline-block bg-slate-800 text-white font-bold px-6 py-3 rounded-xl hover:bg-slate-700 transition-colors">
					Voltar para o início
				</a>
				<a href="/cadastro" class="inline-block border-2 border-amber-500 text-amber-600 font-bold px-6 py-3 rounded-xl hover:bg-amber-50 transition-colors">
					Cadastre-se como montador
				</a>
			</div>
		</section>
	</main>
</Layout>