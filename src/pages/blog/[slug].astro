---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import BottomNavBar from '../../components/BottomNavBar.astro';
import { getCollection, render } from 'astro:content';
import { getAuthorName } from '../../lib/authors';

// Fonte unica de verdade: data.slug (do frontmatter). O nome do arquivo (post.id)
// entra apenas como referencia de log quando divergir do slug.
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);

  for (const post of posts) {
    if (post.data.slug && post.data.slug !== post.id) {
      console.info(`[blog] ${post.id}.md serve a rota /blog/${post.data.slug} (file id divergente)`);
    }
  }

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

// Helper puro de imagem: devolve o src usado na tag <img> e a URL absoluta usada
// apenas no Open Graph e no JSON-LD (absoluta montada via Astro.site).
function resolverImagem(image, site) {
  if (!image) return { src: undefined, absoluta: undefined };
  if (/^https?:\/\//i.test(image)) return { src: image, absoluta: image };
  const base = String(site ?? '').replace(/\/+$/, '');
  return {
    src: image,
    absoluta: `${base}${image.startsWith('/') ? '' : '/'}${image}`,
  };
}

const { post } = Astro.props;
const { Content } = await render(post);

const noindex = post.data.noindex;
const title = post.data.title;
const description = post.data.description;

const site = Astro.site ? Astro.site.toString().replace(/\/+$/, '') : 'https://portal.omontadordemoveis.com';
const canonical = site + Astro.url.pathname;

const { src: imageSrc, absoluta: imagemAbsoluta } = resolverImagem(post.data.image ?? '', site);

// P2C: authorId -> Person real via registro tipado (src/lib/authors.ts).
// publisher continua apontando para a Organization existente no Layout global (#organization).
const authorName = getAuthorName(post.data.authorId);
const graph: any[] = [];

if (!noindex) {
  graph.push(
    {
      "@type": "BlogPosting",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonical
      },
      "headline": title,
      "description": description,
      "image": imagemAbsoluta,
      "datePublished": post.data.publishedAt.toISOString(),
      "dateModified": post.data.updatedAt ? post.data.updatedAt.toISOString() : post.data.publishedAt.toISOString(),
      "author": {
        "@type": "Person",
        "name": authorName,
        "@id": `${site}/#author-${post.data.authorId}`
      },
      "publisher": {
        "@type": "Organization",
        "@id": `${site}/#organization`
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": site
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": `${site}/blog`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": canonical
        }
      ]
    }
  );

  if (post.data.faq && post.data.faq.length > 0) {
    graph.push({
      "@type": "FAQPage",
      "mainEntity": post.data.faq.map(q => ({
        "@type": "Question",
        "name": q.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": q.answer
        }
      }))
    });
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graph
};
---

<Layout title={title} description={description} noindex={noindex} image={imagemAbsoluta}>
  <Header />
  {!noindex && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  )}

  <nav aria-label="Breadcrumb" class="max-w-prose mx-auto px-4 pt-8 pb-4">
    <ol class="flex items-center space-x-2 text-sm text-on-surface-variant">
      <li><a href="/" class="hover:text-primary transition-colors">Início</a></li>
      <li><span class="material-symbols-outlined text-sm">chevron_right</span></li>
      <li><a href="/blog" class="hover:text-primary transition-colors">Blog</a></li>
      <li><span class="material-symbols-outlined text-sm">chevron_right</span></li>
      <li class="font-medium text-on-surface truncate" aria-current="page">{title}</li>
    </ol>
  </nav>

  <article class="max-w-prose mx-auto px-4 py-8">
    <header class="mb-10">
      <div class="mb-6 flex flex-wrap items-center gap-4 text-sm text-on-surface-variant">
        <span class="inline-block px-3 py-1 bg-primary-container text-on-primary-container font-semibold rounded-full">
          {post.data.category}
        </span>
        <time datetime={post.data.publishedAt.toISOString()} class="flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">calendar_today</span>
          {post.data.publishedAt.toLocaleDateString('pt-BR')}
        </time>
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">person</span>
          Por {authorName}
        </span>
</div>

    <h1 class="text-4xl md:text-5xl font-headline font-bold text-on-surface mb-6 leading-tight">{title}</h1>

    {imageSrc && (
        <figure class="mb-10">
          <img src={imageSrc} alt={post.data.imageAlt} class="w-full h-auto rounded-2xl ambient-shadow-sm" />
        </figure>
      )}
    </header>

    <div class="blog-content mb-12 text-on-surface-variant text-lg">
      <Content />
    </div>

    {post.data.faq && post.data.faq.length > 0 && (
      <section class="mb-12 border-t border-surface-container-highest pt-8">
        <h2 class="text-2xl font-headline font-bold text-on-surface mb-6">Perguntas Frequentes</h2>
        <div class="space-y-6">
          {post.data.faq.map(q => (
            <div>
              <h3 class="text-lg font-headline font-semibold text-on-surface mb-2">{q.question}</h3>
              <p class="text-on-surface-variant leading-relaxed">{q.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {post.data.sources && post.data.sources.length > 0 && (
      <section class="mb-12 border-t border-surface-container-highest pt-8">
        <h2 class="text-xl font-headline font-bold text-on-surface mb-4">Fontes e Referências</h2>
        <ul class="space-y-3 text-sm text-on-surface-variant list-disc pl-5">
          {post.data.sources.map(s => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors underline underline-offset-2">
                {s.title}
              </a>
              {s.publisher && <span class="ml-1">- {s.publisher}</span>}
              {s.accessedAt && <span class="ml-1">(Acessado em {s.accessedAt.toLocaleDateString('pt-BR')})</span>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <BottomNavBar />
</Layout>

<style is:global>
  .blog-content h2 {
    font-family: 'Manrope', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-on-surface);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .blog-content h3 {
    font-family: 'Manrope', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-on-surface);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .blog-content h4 {
    font-family: 'Manrope', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-on-surface);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .blog-content p {
    color: var(--color-on-surface-variant);
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }
  .blog-content ul, .blog-content ol {
    color: var(--color-on-surface-variant);
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .blog-content ul {
    list-style-type: disc;
  }
  .blog-content ol {
    list-style-type: decimal;
  }
  .blog-content li {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }
  .blog-content a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-primary-container);
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }
  .blog-content a:hover {
    color: var(--color-secondary);
  }
  .blog-content blockquote {
    border-left: 4px solid var(--color-primary-container);
    padding-left: 1.5rem;
    margin-left: 0;
    margin-right: 0;
    font-style: italic;
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface-container-low);
    padding: 1rem 1rem 1rem 1.5rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .blog-content img {
    border-radius: 0.75rem;
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  .blog-content strong {
    font-weight: 600;
    color: var(--color-on-surface);
  }
</style>
