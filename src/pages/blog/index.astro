---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import BottomNavBar from '../../components/BottomNavBar.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true && data.noindex !== true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const isEmpty = sortedPosts.length === 0;

const title = "Blog | Portal O Montador de Móveis";
const description = "Dicas, guias e informações úteis sobre montagem de móveis, planejamento e cuidados com seus móveis.";
---

<Layout title={title} description={description} noindex={isEmpty}>
  <Header />

  <main class="max-w-4xl mx-auto px-4 py-8">
    <header class="mb-12 text-center">
      <h1 class="text-4xl font-headline font-bold text-primary mb-4">Blog do Montador</h1>
      <p class="text-lg text-on-surface-variant">Guias, dicas e informações para quem precisa montar ou desmontar móveis com segurança.</p>
    </header>

    {isEmpty ? (
      <section class="text-center py-16 bg-surface-container rounded-2xl">
        <span class="material-symbols-outlined text-6xl text-primary mb-4">article</span>
        <h2 class="text-2xl font-headline font-semibold text-on-surface mb-2">Nenhum artigo publicado ainda</h2>
        <p class="text-on-surface-variant">Estamos preparando conteúdos incríveis para você. Volte em breve!</p>
      </section>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedPosts.map(post => (
          <article class="bg-surface rounded-2xl overflow-hidden ambient-shadow-sm border border-surface-container-highest transition-transform hover:-translate-y-1">
            {post.data.image && (
              <img src={post.data.image} alt={post.data.imageAlt} class="w-full h-48 object-cover" />
            )}
            <div class="p-6">
              <span class="inline-block px-3 py-1 bg-primary-container text-on-primary-container text-xs font-semibold rounded-full mb-4">
                {post.data.category}
              </span>
              <h2 class="text-xl font-headline font-bold text-on-surface mb-2">
                <a href={`/blog/${post.data.slug ?? post.id}`} class="hover:text-primary transition-colors">{post.data.title}</a>
              </h2>
              <p class="text-on-surface-variant mb-4 line-clamp-3">{post.data.description}</p>
              <div class="flex items-center justify-between text-sm text-on-surface-variant">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toLocaleDateString('pt-BR')}
                </time>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </main>

  <BottomNavBar />
</Layout>
